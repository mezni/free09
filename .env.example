# Telco Platform — example environment configuration
#
# Copy to `.env` and replace every placeholder value with a locally supplied
# value. Never commit a populated `.env`.
#
# Format: each variable is preceded by a comment naming the variable and
# stating whether it is required or optional. This file realises the
# configuration contract in
# `specs/001-project-setup/contracts/configuration-contract.md`; the
# `governance` check fails when the two drift apart.

# TELECO_ENV: required — environment selector (dev, test, ci, prod)
TELECO_ENV=dev
# TELECO_LOG_LEVEL: optional — minimum severity emitted to stdout
TELECO_LOG_LEVEL=INFO
# TELECO_LOG_FORMAT: optional — log serialisation (json, text)
TELECO_LOG_FORMAT=json
# TELECO_LOG_CORRELATION_HEADER: optional — header carrying the correlation identifier
TELECO_LOG_CORRELATION_HEADER=X-Correlation-ID

# TELECO_SERVICE_NAME: required — name of the running service
TELECO_SERVICE_NAME=telco-platform
# TELECO_SERVICE_ROLE: optional — role assumed by the service in the topology
TELECO_SERVICE_ROLE=default

# TELECO_DB_URL: optional — service connection URL; overrides the TELECO_DB_* components when set
TELECO_DB_URL=sqlite:///./telco_platform.db
# TELECO_DB_HOST: optional — PostgreSQL host
TELECO_DB_HOST=127.0.0.1
# TELECO_DB_PORT: optional — PostgreSQL port
TELECO_DB_PORT=5432
# TELECO_DB_NAME: optional — PostgreSQL database name
TELECO_DB_NAME=telco_si
# TELECO_DB_USER: optional — PostgreSQL application role
TELECO_DB_USER=telco_app
# TELECO_DB_PASSWORD: optional — PostgreSQL application role credential placeholder
TELECO_DB_PASSWORD=PLACEHOLDER_NO_REAL_CREDENTIAL
# TELECO_DB_SSLMODE: optional — TLS mode for the connection
TELECO_DB_SSLMODE=prefer
# TELECO_DB_POOL_SIZE: optional — connections held open per process
TELECO_DB_POOL_SIZE=5
# TELECO_DB_POOL_MAX_OVERFLOW: optional — additional connections permitted under load
TELECO_DB_POOL_MAX_OVERFLOW=10
# TELECO_DB_CONNECT_TIMEOUT_SECONDS: optional — connection establishment timeout
TELECO_DB_CONNECT_TIMEOUT_SECONDS=10
# TELECO_DB_STATEMENT_TIMEOUT_MS: optional — server-side statement timeout
TELECO_DB_STATEMENT_TIMEOUT_MS=30000

# AUTH_DATABASE_URL: optional — reserved for the auth service connection URL
AUTH_DATABASE_URL=PLACEHOLDER_NO_REAL_CREDENTIAL
# CRM_DATABASE_URL: optional — reserved for the crm service connection URL
CRM_DATABASE_URL=PLACEHOLDER_NO_REAL_CREDENTIAL
# BILLING_DATABASE_URL: optional — reserved for the billing service connection URL
BILLING_DATABASE_URL=PLACEHOLDER_NO_REAL_CREDENTIAL
# INVENTORY_DATABASE_URL: optional — reserved for the inventory service connection URL
INVENTORY_DATABASE_URL=PLACEHOLDER_NO_REAL_CREDENTIAL

# TELECO_API_HOST: optional — reserved for the service HTTP bind address
TELECO_API_HOST=127.0.0.1
# TELECO_API_PORT: optional — reserved for the service HTTP bind port
TELECO_API_PORT=8000
# TELECO_JWT_SIGNING_KEY: optional — reserved for token issuance signing material
TELECO_JWT_SIGNING_KEY=PLACEHOLDER_NO_REAL_CREDENTIAL
# TELECO_JWT_ALGORITHM: optional — reserved for the token signing algorithm
TELECO_JWT_ALGORITHM=RS256
# TELECO_JWT_ISSUER: optional — reserved for the expected token issuer
TELECO_JWT_ISSUER=telco-si
# TELECO_JWT_AUDIENCE: optional — reserved for the expected token audience
TELECO_JWT_AUDIENCE=telco-si
# TELECO_JWT_TTL_SECONDS: optional — reserved for the access-token lifetime
TELECO_JWT_TTL_SECONDS=900
# TELECO_OTEL_EXPORTER_OTLP_ENDPOINT: optional — OTLP/HTTP collector endpoint (Jaeger: http://localhost:4318)
TELECO_OTEL_EXPORTER_OTLP_ENDPOINT=
# TELECO_WEBHOOK_SECRET: optional — HMAC secret for webhook signature validation
TELECO_WEBHOOK_SECRET=PLACEHOLDER_NO_REAL_CREDENTIAL
# TELECO_LOG_LOKI_URL: optional — Loki base URL used by log shipping (http://localhost:3100)
TELECO_LOG_LOKI_URL=
# TELECO_OTEL_ALERTMANAGER_URL: optional — Alertmanager API base URL (http://localhost:9093)
TELECO_OTEL_ALERTMANAGER_URL=
# TELECO_OTEL_ISTIO_ENABLED: optional — enable Istio mesh observability defaults (true/false)
TELECO_OTEL_ISTIO_ENABLED=false
