# Telco Platform — example environment configuration
#
# Copy to `.env` and replace every placeholder value with a locally supplied
# value. Never commit a populated `.env`.
#
# Format: each variable is preceded by a comment naming the variable and
# stating whether it is required or optional.

# DB_HOST: required — database hostname
DB_HOST=localhost
# DB_PORT: required — database port
DB_PORT=5432
# DB_NAME: required — database name
DB_NAME=telco_db
# DB_USER: required — database user
DB_USER=telco_user
# DB_PASSWORD: required — database password placeholder
DB_PASSWORD=PLACEHOLDER_NO_REAL_CREDENTIAL

# SERVICE_NAME: required — name of the running service
SERVICE_NAME=auth-service
# SERVICE_ROLE: optional — role assumed by the service in the topology
SERVICE_ROLE=default

# FEATURE_FLAG_A: optional — default-off feature flag
FEATURE_FLAG_A=
# FEATURE_FLAG_B: optional — default-off feature flag
FEATURE_FLAG_B=
