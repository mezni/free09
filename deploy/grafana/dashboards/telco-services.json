{
  "uid": "telco-services",
  "title": "Telco Services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["telco", "observability"],
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(service_requests_total, service)",
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "auth-service request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(service_requests_total{service=\"auth-service\"}[5m]))"}]
    },
    {
      "id": 2,
      "title": "crm-service request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(service_requests_total{service=\"crm-service\"}[5m]))"}]
    },
    {
      "id": 3,
      "title": "billing-service request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(service_requests_total{service=\"billing-service\"}[5m]))"}]
    },
    {
      "id": 4,
      "title": "notification-service request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum(rate(service_requests_total{service=\"notification-service\"}[5m]))"}]
    },
    {
      "id": 5,
      "title": "p95 latency by service",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(service_request_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
